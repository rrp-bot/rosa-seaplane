{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Preview cert-manager chart changes after submodule updates",
      "matchManagers": ["git-submodules"],
      "postUpgradeTasks": {
        "commands": ["./ci/cert-manager-chart-preview.sh"],
        "executionMode": "branch",
        "fileFilters": ["argocd/config/shared/cert-manager/**"]
      }
    }
  ]
}
